import { useState, useEffect } from "react";
import { supabase } from "./supabaseClient";

export default function Register() {
  const [email, setEmail] = useState("");
  const [password, setPassword] = useState("");
  const [sector, setSector] = useState("");
  const [schools, setSchools] = useState([]);
  const [schoolId, setSchoolId] = useState("");
  const [loading, setLoading] = useState(false);
  const [message, setMessage] = useState("");

  // When the sector changes, find all schools in that sector
  useEffect(() => {
    setSchoolId("");
    const value = sector.trim();

    if (value.length < 2) {
      setSchools([]);
      return;
    }

    const timer = setTimeout(async () => {
      const { data, error } = await supabase
        .from("schools")
        .select("id, name")
        .ilike("sector", `%${value}%`)
        .order("name");

      if (error) {
        console.error(error);
        setSchools([]);
      } else {
        setSchools(data);
      }
    }, 300);

    return () => clearTimeout(timer);
  }, [sector]);

  async function handleSubmit(e) {
    e.preventDefault();
    if (!schoolId) {
      setMessage("Please select your school.");
      return;
    }

    setLoading(true);
    setMessage("");

    // 1. Sign up
    const { data, error } = await supabase.auth.signUp({ email, password });
    if (error) {
      setMessage(error.message);
      setLoading(false);
      return;
    }

    // 2. Save the user's school
    const { error: memberError } = await supabase
      .from("school_memberships")
      .insert({ user_id: data.user.id, school_id: schoolId });

    if (memberError) {
      setMessage("Registration succeeded but the school was not saved: " + memberError.message);
    } else {
      setMessage("Registration successful!");
    }
    setLoading(false);
  }

  return (
    <form onSubmit={handleSubmit} style={{ maxWidth: 400, margin: "auto" }}>
      <h2>Register</h2>

      <input
        type="email"
        placeholder="Email"
        value={email}
        onChange={(e) => setEmail(e.target.value)}
        required
      />

      <input
        type="password"
        placeholder="Password"
        value={password}
        onChange={(e) => setPassword(e.target.value)}
        required
      />

      <input
        placeholder="Enter the sector you live in"
        value={sector}
        onChange={(e) => setSector(e.target.value)}
        required
      />

      {sector.trim().length >= 2 && schools.length === 0 && (
        <p>No schools found in this sector.</p>
      )}

      {schools.length > 0 && (
        <select
          value={schoolId}
          onChange={(e) => setSchoolId(e.target.value)}
          required
        >
          <option value="">Select your school</option>
          {schools.map((s) => (
            <option key={s.id} value={s.id}>
              {s.name}
            </option>
          ))}
        </select>
      )}

      <button type="submit" disabled={loading}>
        {loading ? "Please wait..." : "Register"}
      </button>

      {message && <p>{message}</p>}
    </form>
  );
}
